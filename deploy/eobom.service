[Unit]
Description=Eobom meditation journal (Next.js)
After=network.target

[Service]
Type=simple
User=declan
Group=declan
WorkingDirectory=/home/declan/apps/eobom
Environment=NODE_ENV=production
Environment=PORT=3120
Environment=HOSTNAME=127.0.0.1
Environment=PATH=/home/declan/.bun/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/home/declan/apps/eobom/.env
ExecStart=/home/declan/.bun/bin/bun /home/declan/apps/eobom/.next/standalone/server.js
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
