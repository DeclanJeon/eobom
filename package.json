{
  "name": "eobom",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "prisma generate && next build && cp -r .next/static .next/standalone/.next/ && cp -r public .next/standalone/ && mkdir -p .next/standalone/db && cp -r prisma .next/standalone/",
    "start": "HOSTNAME=0.0.0.0 PORT=3100 NODE_ENV=production bun .next/standalone/server.js",
    "lint": "eslint .",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "test": "bun run test:unit",
    "postinstall": "prisma generate",
    "test:unit": "bun test tests/actions.test.ts tests/api-schemas.test.ts tests/bible.test.ts tests/content-scrub.test.ts tests/lib.test.ts tests/past-today.test.ts tests/rate-limit.test.ts tests/reread-scriptures.test.ts tests/together-tags.test.ts tests/user-preferences.test.ts",
    "test:seats": "bun test tests/seats.test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@mdxeditor/editor": "^3.39.1",
    "@prisma/client": "^6.11.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.14",
    "@reactuses/core": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.2",
    "lucide-react": "^0.525.0",
    "next": "^16.1.1",
    "next-auth": "^4.24.11",
    "next-intl": "^4.3.4",
    "next-themes": "^0.4.6",
    "prisma": "^6.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.60.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "react-syntax-highlighter": "^15.6.1",
    "sharp": "^0.34.3",
    "sonner": "^2.0.6",
    "tailwind-merge": "^3.3.1",
    "tailwindcss-animate": "^1.0.7",
    "uuid": "^11.1.0",
    "z-ai-web-dev-sdk": "^0.0.18",
    "zod": "^4.0.2",
    "@auth/prisma-adapter": "^2.9.1",
    "nodemailer": "^6.10.1",
    "qrcode": "^1.5.4",
    "nanoid": "^5.1.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-types": "^1.3.4",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "playwright": "^1.62.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5"
  }
}
