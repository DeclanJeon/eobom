generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                        String    @id @default(cuid())
  email                     String    @unique
  emailVerified             DateTime?
  name                      String?
  displayName               String?
  image                     String?
  profileImageUrl           String?
  locale                    String    @default("ko")
  timezone                  String    @default("Asia/Seoul")
  preferredBibleTranslation String    @default("한국어 성경 (Open Bibles)")
  personalSlug              String    @unique @default(cuid())
  aiProcessingConsent       Boolean   @default(false)
  communityEnabled          Boolean   @default(false)
  pastTodayEnabled          Boolean   @default(true)
  seatClaimedAt             DateTime?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt
  deletedAt                 DateTime?

  accounts            Account[]
  sessions            Session[]
  reflectionEntries   ReflectionEntry[]
  prayerTopics        PrayerTopic[]
  actionSteps         ActionStep[]
  reviewReports       ReviewReport[]
  sharedReflections   SharedReflection[]
  communityReactions  CommunityReaction[]
  safetyReports       SafetyReport[]
  consentRecords      ConsentRecord[]
  contactInquiries    ContactInquiry[]
  claimedSeat         JournalSeat?

  @@index([personalSlug])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model ReflectionEntry {
  id               String    @id @default(cuid())
  userId           String
  entryDate        DateTime
  title            String?
  scriptureRefs    String    @default("[]")
  scriptureExcerpt String?
  scriptureBindings String    @default("[]")
  reflectionBody   String
  gratitude        String?
  question         String?
  prayer           String?
  actionStep       String?
  emotions         String    @default("[]")
  tags             String    @default("[]")
  templateType     String    @default("free")
  privateNote      String?
  cellShareSummary String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  prayerTopics      PrayerTopic[]
  actionSteps       ActionStep[]
  sharedReflections SharedReflection[]
  reviewEvidences   ReviewEvidence[]

  @@index([userId])
  @@index([entryDate])
  @@index([userId, entryDate])
}

model PrayerTopic {
  id            String    @id @default(cuid())
  userId        String
  sourceEntryId String?
  title         String
  body          String?
  status        String    @default("continuing")
  startedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  closedAt      DateTime?

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntry ReflectionEntry? @relation(fields: [sourceEntryId], references: [id])

  @@index([userId])
}

model ActionStep {
  id                 String    @id @default(cuid())
  userId             String
  sourceEntryId      String?
  body               String
  targetDate         DateTime?
  status             String    @default("pending")
  reflectionOnResult String?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceEntry ReflectionEntry? @relation(fields: [sourceEntryId], references: [id])

  @@index([userId])
}

model ReviewReport {
  id               String    @id @default(cuid())
  userId           String
  periodStart      DateTime
  periodEnd        DateTime
  reportType       String    @default("monthly")
  includedEntryIds String    @default("[]")
  excludedEntryIds String    @default("[]")
  structuredOutput String
  summary          String?
  modelProvider    String?
  modelName        String?
  promptVersion    String?
  createdAt        DateTime  @default(now())
  deletedAt        DateTime?

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  evidences ReviewEvidence[]

  @@index([userId])
}

model ReviewEvidence {
  id             String @id @default(cuid())
  reportId       String
  observationKey String
  entryId        String
  excerpt        String
  confidence     String @default("medium")
  evidenceType   String @default("supporting")

  report ReviewReport    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  entry  ReflectionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

model SharedReflection {
  id               String    @id @default(cuid())
  ownerUserId      String
  sourceEntryId    String?
  publicBody       String
  scriptureRefs    String    @default("[]")
  topicTags        String    @default("[]")
  pseudonym        String?
  safetyScanResult String?
  visibility       String    @default("public")
  publishedAt      DateTime  @default(now())
  withdrawnAt      DateTime?
  deletedAt        DateTime?

  owner       User                @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  sourceEntry ReflectionEntry?    @relation(fields: [sourceEntryId], references: [id])
  reactions   CommunityReaction[]
  safetyReports SafetyReport[]

  @@index([ownerUserId])
  @@index([visibility])
  @@index([publishedAt])
}

model CommunityReaction {
  id                 String   @id @default(cuid())
  sharedReflectionId String
  userId             String
  reactionType       String
  createdAt          DateTime @default(now())

  sharedReflection SharedReflection @relation(fields: [sharedReflectionId], references: [id], onDelete: Cascade)
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sharedReflectionId, userId, reactionType])
  @@index([sharedReflectionId])
}

model SafetyReport {
  id                 String    @id @default(cuid())
  reporterUserId     String
  sharedReflectionId String
  reason             String
  details            String?
  status             String    @default("pending")
  createdAt          DateTime  @default(now())
  resolvedAt         DateTime?

  reporter         User             @relation(fields: [reporterUserId], references: [id], onDelete: Cascade)
  sharedReflection SharedReflection @relation(fields: [sharedReflectionId], references: [id], onDelete: Cascade)

  @@index([sharedReflectionId])
}

model ConsentRecord {
  id            String    @id @default(cuid())
  userId        String
  consentType   String
  policyVersion String
  granted       Boolean
  createdAt     DateTime  @default(now())
  withdrawnAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ContactInquiry {
  id        String    @id @default(cuid())
  userId    String?
  name      String
  email     String
  subject   String
  message   String
  status    String    @default("new")
  createdAt DateTime  @default(now())
  handledAt DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
}

model JournalSeat {
  id            String    @id @default(cuid())
  slug          String    @unique
  seatCode      String    @unique
  label         String?
  status        String    @default("unclaimed")
  claimedUserId String?   @unique
  claimedAt     DateTime?
  claimedEmail  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  claimedUser User? @relation(fields: [claimedUserId], references: [id], onDelete: SetNull)

  @@index([status])
}
